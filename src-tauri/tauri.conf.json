{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "running-crew",
  "version": "0.1.0",
  "identifier": "com.user.running-crew",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main-window",
        "title": "running-crew",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "playable-window",
        "title": "running-crew",
        "width": 400,
        "height": 100,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "url": "index.html#/home"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
